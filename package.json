{
  "name": "csv-reader",
  "version": "0.1.3",
  "description": "Desktop app for reading, searching, editing, and exporting large CSV files",
  "author": "fulracoco",
  "license": "MIT",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "version:check": "node scripts/sync-version.js --check",
    "version": "npm run version:sync",
    "predev": "npm run version:check",
    "dev": "tauri dev",
    "prebuild": "npm run version:check",
    "build": "tauri build",
    "prebuild:win": "npm run version:check",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "prebuild:mac-x64": "npm run version:check",
    "build:mac-x64": "tauri build --target x86_64-apple-darwin",
    "prebuild:mac-arm64": "npm run version:check",
    "build:mac-arm64": "tauri build --target aarch64-apple-darwin",
    "prebuild:linux": "npm run version:check",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
